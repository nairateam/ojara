# Root env: used by docker-compose.yml only. App settings live in apps/api/.env and apps/web/.env.
# Copy to `.env` to override defaults. Never commit real secrets.

# Postgres superuser that owns the schema and runs migrations (local only).
POSTGRES_USER=ojara_owner
POSTGRES_PASSWORD=ojara_owner_dev
POSTGRES_DB=ojara
POSTGRES_PORT=5432
# Password for the non-superuser `ojara_app` role the API connects as (RLS enforced).
OJARA_APP_PASSWORD=ojara_app_dev

REDIS_PORT=6379

# Mailpit catches all local email. UI: http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
