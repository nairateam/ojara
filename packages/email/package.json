{
  "name": "@ojara/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "preview": "email dev --dir src/templates --port 3030",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.13"
  },
  "devDependencies": {
    "@ojara/eslint-config": "workspace:*",
    "@ojara/tsconfig": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
