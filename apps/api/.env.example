# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed by CORS (the web app's hosts).
CORS_ORIGINS=http://ojara.localhost:3000,http://app.ojara.localhost:3000,http://admin.ojara.localhost:3000
LOG_LEVEL=debug

# ───────── Platform ─────────
# Root domain for host-based routing. Must match the web app's NEXT_PUBLIC_ROOT_DOMAIN.
ROOT_DOMAIN=ojara.localhost
# Public URL of the web app's merchant dashboard (used in emails and auth redirects).
DASHBOARD_URL=http://app.ojara.localhost:3000
# Public base URL of this API (used for Better Auth callback/verification links).
API_PUBLIC_URL=http://api.ojara.localhost:4000
# Shared secret the web app sends on /v1/internal/* calls (x-internal-token header).
INTERNAL_API_TOKEN=change-me-local-internal-token

# ───────── Database ─────────
# Runtime connection: the NON-superuser `ojara_app` role, so Postgres RLS is enforced.
DATABASE_URL=postgresql://ojara_app:ojara_app_dev@localhost:5432/ojara
# Migration/seed connection: the schema owner. Used by prisma.config.ts and the seed only.
DATABASE_MIGRATION_URL=postgresql://ojara_owner:ojara_owner_dev@localhost:5432/ojara

# ───────── Redis (BullMQ queues, rate limits) ─────────
REDIS_URL=redis://localhost:6379

# ───────── Auth (Better Auth) ─────────
# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Seeded platform admin (pnpm db:seed). Local only.
SEED_ADMIN_EMAIL=admin@ojara.localhost
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
# Google sign-in (optional). Create an OAuth client (Web application) in Google Cloud Console.
# Authorised redirect URI: {API_PUBLIC_URL}/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Reject passwords found in known data breaches (Have I Been Pwned). Set false only offline.
PASSWORD_BREACH_CHECK=true
# Platform-admin sessions end this many hours after sign-in (admins also need 2FA).
ADMIN_SESSION_MAX_HOURS=8

# ───────── Email (Resend) ─────────
# Leave RESEND_API_KEY empty locally: email goes to Mailpit (MAILPIT_API_URL) or is logged.
RESEND_API_KEY=
EMAIL_FROM="Ojara <hello@ojara.localhost>"
# Local fallback: Mailpit HTTP API (docker compose). Leave empty to only log emails.
MAILPIT_API_URL=http://localhost:8025

# ───────── Media (Cloudinary) ─────────
# Required to issue upload signatures. Find these in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────── Payments (Paystack) ─────────
# Test keys start with sk_test_ / pk_test_. The secret key also signs webhooks (HMAC SHA512).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
