{
  "name": "@ojara/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ojara/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ojara/eslint-config": "workspace:*",
    "@ojara/tsconfig": "workspace:*",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": "prettier --write --ignore-unknown"
  }
}
