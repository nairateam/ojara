# ───────── Public (inlined into browser bundles) ─────────
# Platform root domain. Must match the API's ROOT_DOMAIN.
NEXT_PUBLIC_ROOT_DOMAIN=ojara.localhost
# API URL used by browsers. Must be on the same cookie domain as the web app (api.ROOT_DOMAIN).
NEXT_PUBLIC_API_URL=http://api.ojara.localhost:4000
# Cloudinary cloud name for the next/image loader (public, not a secret). Optional locally.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ───────── Server only ─────────
# API URL reachable from the Next.js server (proxy + Server Components).
API_INTERNAL_URL=http://localhost:4000
# Must equal INTERNAL_API_TOKEN in apps/api/.env (authorises /v1/internal/* calls).
INTERNAL_API_TOKEN=change-me-local-internal-token
# How long the proxy caches a resolved host -> store mapping in memory.
TENANT_CACHE_TTL_SECONDS=60
